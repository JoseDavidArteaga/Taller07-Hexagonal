{
  "info": {
    "_postman_id": "asae-taller07-hex-001",
    "name": "ASAE Taller 07 - Pruebas Hexagonal",
    "description": "Coleccion organizada para validar los 5 requisitos del taller: 1) Validaciones automaticas, 2) Validacion personalizada (VerboInfinitivo), 3) Reglas de negocio, 4) 8 Servicios REST, 5) Lazy vs Eager. Ejecutar con Collection Runner en orden secuencial.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup Global",
      "item": [
        {
          "name": "Setup - Crear Docente base",
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\"tipoIdentificacion\":\"CC\",\"numeroIdentificacion\":\"999001\",\"nombres\":\"Docente\",\"apellidos\":\"Base\",\"correo\":\"docente.base@unicauca.edu.co\",\"departamento\":\"Sistemas\"}"},
            "url": "{{baseUrl}}/docentes"
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 201',function(){pm.response.to.have.status(201);});","var j=pm.response.json();","pm.collectionVariables.set('docenteId',j.idPersona);","pm.collectionVariables.set('docenteCorreo',j.correo);"]}}]
        },
        {
          "name": "Setup - Crear FormatoA base",
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\"titulo\":\"Formato Base Unico\",\"objetivos\":[\"Analizar requisitos\",\"Diseñar solucion\",\"Implementar sistema\"],\"docente\":{\"idPersona\":{{docenteId}},\"tipoIdentificacion\":\"CC\",\"numeroIdentificacion\":\"999001\",\"nombres\":\"Docente\",\"apellidos\":\"Base\",\"correo\":\"docente.base@unicauca.edu.co\",\"departamento\":\"Sistemas\"}}"},
            "url": "{{baseUrl}}/formatosA"
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 201',function(){pm.response.to.have.status(201);});","var j=pm.response.json();","pm.collectionVariables.set('formatoId',j.idFormatoA);","pm.collectionVariables.set('formatoTitulo',j.titulo);"]}}]
        }
      ]
    },
    {
      "name": "1. Validaciones Automaticas",
      "item": [
        {
          "name": "VA1 - Titulo nulo",
          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"titulo\":null,\"objetivos\":[\"Analizar requisitos\",\"Diseñar solucion\",\"Implementar sistema\"],\"docente\":{\"tipoIdentificacion\":\"CC\",\"numeroIdentificacion\":\"123\",\"nombres\":\"Ana\",\"apellidos\":\"Diaz\",\"correo\":\"ana@unicauca.edu.co\",\"departamento\":\"Sistemas\"}}"},"url":"{{baseUrl}}/formatosA"},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 400',function(){pm.response.to.have.status(400);});","pm.test('Error titulo presente',function(){pm.expect(pm.response.json()).to.have.property('titulo');});"]}}]
        },
        {
          "name": "VA2 - Titulo corto",
          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"titulo\":\"abc\",\"objetivos\":[\"Analizar requisitos\",\"Diseñar solucion\",\"Implementar sistema\"],\"docente\":{\"tipoIdentificacion\":\"CC\",\"numeroIdentificacion\":\"123\",\"nombres\":\"Ana\",\"apellidos\":\"Diaz\",\"correo\":\"ana2@unicauca.edu.co\",\"departamento\":\"Sistemas\"}}"},"url":"{{baseUrl}}/formatosA"},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 400',function(){pm.response.to.have.status(400);});","pm.test('Error titulo presente',function(){pm.expect(pm.response.json()).to.have.property('titulo');});"]}}]
        },
        {
