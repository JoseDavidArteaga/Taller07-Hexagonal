          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 400',function(){pm.response.to.have.status(400);});","pm.test('Error objetivos presente',function(){pm.expect(pm.response.json()).to.have.property('objetivos');});"]}}]
        },
