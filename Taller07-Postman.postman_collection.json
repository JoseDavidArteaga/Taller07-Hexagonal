              "raw": "{\n  \"descripcion\": \"Revisar los objetivos: deben ir en infinitivo y ser medibles.\",\n  \"idFormatoA\": {{idFormatoA}},\n  \"idsDocentes\": [{{idDocente1}}, {{idDocente2}}]\n}"
