    },
    {
      "name": "2.3 Listar Observaciones (EAGER por @EntityGraph)",
      "item": [
        {
          "name": "GET observaciones por FormatoA",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/observaciones/formatoA/{{idFormatoA}}", "host": ["{{baseUrl}}"], "path": ["api","observaciones","formatoA","{{idFormatoA}}"] }
          }
        }
      ]
    },
    {
      "name": "2.4 Listar Miembros del Comite (LAZY roles/historicos)",
      "item": [
        {
          "name": "GET docentes/comite",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/docentes/comite", "host": ["{{baseUrl}}"], "path": ["api","docentes","comite"] }
          }
        }
      ]
    },
    {
      "name": "2.5 Formatos A por Docente (EAGER formatos+estado / LAZY evaluacion)",
      "item": [
        {
          "name": "GET formatosA/docente/{idDocente}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/formatosA/docente/{{idDocente1}}", "host": ["{{baseUrl}}"], "path": ["api","formatosA","docente","{{idDocente1}}"] }
          }
        }
      ]
    },
    {
      "name": "2.6 Listar Docentes (keyword)",
      "item": [
        {
          "name": "GET todos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/docentes", "host": ["{{baseUrl}}"], "path": ["api","docentes"] }
          }
        },
        {
          "name": "GET por nombres (keyword)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/docentes?nombres=Carlos",
              "host": ["{{baseUrl}}"], "path": ["api","docentes"],
              "query": [{ "key": "nombres", "value": "Carlos" }]
            }
          }
        },
        {
          "name": "GET filtrar por grupo y patron",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/docentes/filtrar?grupo=Sistemas&patron=Pe",
              "host": ["{{baseUrl}}"], "path": ["api","docentes","filtrar"],
              "query": [
                { "key": "grupo", "value": "Sistemas" },
                { "key": "patron", "value": "Pe" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2.7 Actualizar Estado Formato A (@Query @Modifying)",
      "item": [
        {
          "name": "PUT formatosA/{id}/estado",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/formatosA/{{idFormatoA}}/estado", "host": ["{{baseUrl}}"], "path": ["api","formatosA","{{idFormatoA}}","estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"Aprobado\"\n}" }
          }
        },
        {
          "name": "Error: id inexistente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/formatosA/99999/estado", "host": ["{{baseUrl}}"], "path": ["api","formatosA","99999","estado"] },
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"Aprobado\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2.8 Historico de Evaluaciones (@Query JPQL)",
      "item": [
        {
          "name": "GET evaluaciones/historico/{idFormatoA}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/evaluaciones/historico/{{idFormatoA}}", "host": ["{{baseUrl}}"], "path": ["api","evaluaciones","historico","{{idFormatoA}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Pruebas Lazy vs Eager (analizar consola)",
      "item": [
        {
          "name": "3.1 EAGER via @EntityGraph - GET observaciones/formatoA/{id}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/observaciones/formatoA/{{idFormatoA}}", "host": ["{{baseUrl}}"], "path": ["api","observaciones","formatoA","{{idFormatoA}}"] },
            "description": "Espera: UN SOLO SELECT con LEFT OUTER JOIN sobre FormatosA, Estados, Evaluaciones, Observaciones y Docentes. No deben aparecer SELECTs adicionales al iterar la respuesta."
          }
        },
        {
          "name": "3.2 LAZY puro - GET docentes/comite",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/docentes/comite", "host": ["{{baseUrl}}"], "path": ["api","docentes","comite"] },
            "description": "Espera: 1 SELECT de Docentes + 1 SELECT de Historicos por cada docente + 1 SELECT de Roles por cada historico (N+1 = caracteristica LAZY)."
          }
        },
        {
          "name": "3.3 EAGER parcial + LAZY - GET formatosA/docente/{id}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/formatosA/docente/{{idDocente1}}", "host": ["{{baseUrl}}"], "path": ["api","formatosA","docente","{{idDocente1}}"] },
            "description": "Espera: primer SELECT con LEFT OUTER JOIN sobre Docentes y Estados. Las evaluaciones NO se cargan (LAZY)."
          }
        },
        {
          "name": "3.4 Cascada + EAGER del estado - POST /api/formatosA",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/formatosA", "host": ["{{baseUrl}}"], "path": ["api","formatosA"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Demostracion de cascada y EAGER\",\n  \"objetivos\": [\n    \"Verificar cascada PERSIST de docente\",\n    \"Verificar cascada ALL de estado\",\n    \"Confirmar EAGER del estado\"\n  ],\n  \"docente\": {\n    \"tipoIdentificacion\": \"CC\",\n    \"numeroIdentificacion\": \"1061800099\",\n    \"nombres\": \"Nuevo\",\n    \"apellidos\": \"Director\",\n    \"correo\": \"nuevo.director@unicauca.edu.co\",\n    \"departamento\": \"Sistemas\"\n  }\n}"
            },
            "description": "Espera: INSERT Docentes (cascada PERSIST) + INSERT FormatosA + INSERT Estados (cascada ALL). Al mapear la respuesta NO se dispara SELECT extra del estado (EAGER)."
          }
        },
        {
          "name": "3.5 getReference (sin SELECT extra) - POST /api/observaciones",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/observaciones", "host": ["{{baseUrl}}"], "path": ["api","observaciones"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Probando getReference de evaluacion y docentes\",\n  \"idFormatoA\": {{idFormatoA}},\n  \"idsDocentes\": [{{idDocente1}}, {{idDocente2}}]\n}"
            },
            "description": "Espera: NO debe aparecer SELECT * FROM Evaluaciones/Docentes al asociar (proxies). Si la evaluacion no existia: INSERT Evaluaciones + UPDATE concepto + INSERT Observaciones + INSERTs en docentes_observaciones."
          }
        },
        {
          "name": "3.6 JPQL puro con LAZY - GET evaluaciones/historico/{id}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/evaluaciones/historico/{{idFormatoA}}", "host": ["{{baseUrl}}"], "path": ["api","evaluaciones","historico","{{idFormatoA}}"] },
            "description": "Espera: un UNICO SELECT sobre Evaluaciones por idFormatoA. NINGUN SELECT extra sobre FormatosA porque la relacion es LAZY y nadie la invoca."
          }
        }
      ]
    }
  ]
}
